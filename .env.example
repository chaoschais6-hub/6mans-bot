# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Optional: your dev server ID to sync slash commands instantly (without this,
# global commands can take up to ~1 hour to appear)
GUILD_ID=

# Where SQLite data is stored (Fly.io sets this to /data via its volume)
DATA_DIR=data

# Optional: Parse.bot API key for RL Tracker lookups (/link, /rlrank).
# Free tier available at https://parse.bot — 200 requests/month.
RL_TRACKER_API_KEY=
